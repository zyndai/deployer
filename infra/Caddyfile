# zynd-deployer Caddy config.
#
# Single-host, path-based routing. One LE cert for deployer.zynd.ai
# covers everything — no wildcard, no per-tenant cert, no weekly
# rate-limit risk.
#
# Layout:
#   deployer.zynd.ai/                       -> Next.js UI on :3000 (this file)
#   deployer.zynd.ai/agent/<slug>/...       -> container, prefix stripped (worker)
#   deployer.zynd.ai/service/<slug>/...     -> container, prefix stripped (worker)
#
# The worker prepends per-deployment routes (path matchers) into the
# admin API at boot time. Because the worker prepends, its routes
# always evaluate before the catch-all reverse_proxy below — so a
# request like /agent/foo/health hits the container, while /, /docs,
# /deploy etc. fall through to Next.
#
# Requirements:
#   - DNS:      A record  deployer.zynd.ai -> host IP
#   - Firewall: ports 80 (HTTP-01 challenge + auto HTTP->HTTPS) and 443
#   - Caddy:    stock build is fine; no DNS plugins needed

{
    admin 127.0.0.1:2019
    servers {
        trusted_proxies static 127.0.0.1/32
    }
}

deployer.zynd.ai {
    encode gzip
    reverse_proxy 127.0.0.1:3000
}
