# -------- Web + Worker shared config --------

# Postgres connection string (Prisma)
DATABASE_URL="postgresql://zynd:zynd@localhost:5432/zynd_deployer?schema=public"

# Absolute path to the age identity file used to encrypt uploaded keypairs
# at rest. Generate with: age-keygen -o /var/lib/zynd-deployer/master.age
AGE_IDENTITY_PATH="/var/lib/zynd-deployer/master.age"

# Root of per-deployment storage (blobs, decrypted workdirs, encrypted keys).
# Must be writable by the web + worker services.
DEPLOYER_DATA_ROOT="/var/lib/zynd-deployer"

# Wildcard domain. Each deployment gets <slug>.{DEPLOYER_WILDCARD_DOMAIN}.
DEPLOYER_WILDCARD_DOMAIN="deployer.zynd.ai"

# URL of the zynd-dns registry the containers talk to.
ZYND_REGISTRY_URL="https://dns01.zynd.ai"

# Caddy admin API endpoint (local). Changes routes at runtime.
CADDY_ADMIN_URL="http://127.0.0.1:2019"

# Docker socket the worker talks to.
DOCKER_SOCKET="/var/run/docker.sock"

# Base image tags the worker runs for each entity kind.
AGENT_BASE_IMAGE="zynd-deployer/agent-base:latest"
SERVICE_BASE_IMAGE="zynd-deployer/service-base:latest"

# Host-side port range used to bind container port 5000.
DEPLOYER_PORT_MIN=13000
DEPLOYER_PORT_MAX=14000

# Max concurrent deployments (soft cap, enforced in the API).
DEPLOYER_MAX_ACTIVE=50

# Local dev only: skip the Caddy route registration step. The deployment
# will still run (reachable at 127.0.0.1:<port>), just without a tenant
# hostname. Leave unset (or `false`) in production.
DEPLOYER_SKIP_CADDY=true

# docker-compose dev only: host-side path of the data root. The worker
# itself writes to DEPLOYER_DATA_ROOT inside its container; when it asks
# the Docker daemon to bind-mount a workdir into a sibling container,
# it translates the path using this prefix. Leave unset when the worker
# runs on the host.
# HOST_DATA_ROOT="/Users/you/Desktop/p3ai/zynd-deployer/.data"
