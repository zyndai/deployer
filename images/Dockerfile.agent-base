# Base image for Zynd agents deployed via zynd-deployer.
#
# Pre-installs the fat "batteries included" set of agent frameworks so
# cold-start stays under ~15s for the common case. User's requirements.txt
# (if any) is installed at runtime via entrypoint.sh into a side path on
# PYTHONPATH so the base layer stays cached across deployments.
#
# Rebuild manually whenever zyndai-agent or the framework pins move.
#   docker build -f images/Dockerfile.agent-base -t zynd-deployer/agent-base:latest .

FROM python:3.12-slim

# Labels read by /api/images so the deploy UI can filter and display
# this image. `zynd.runtime`, `zynd.kind`, `zynd.flavor` are required;
# operator-built flavor images (e.g. zynd-deployer/agent-playwright)
# should use the same schema with a different `zynd.flavor` value.
LABEL zynd.runtime="python" \
      zynd.kind="agent" \
      zynd.flavor="base" \
      zynd.display="Python Agent (base)" \
      zynd.description="LangChain, LangGraph, CrewAI, pydantic-ai pre-installed"

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
      "zyndai-agent[heartbeat]==0.5.2" \
      python-dotenv \
      requests \
      httpx \
      langchain \
      langchain-openai \
      langchain-community \
      langchain-classic \
      langgraph \
      crewai \
      pydantic-ai

WORKDIR /app

# Container expects the worker to bind-mount the project at /app and
# keypair.json at /app/keypair.json, and to set the ZYND_* env vars.
EXPOSE 5000

COPY images/entrypoint.sh /usr/local/bin/zynd-entrypoint
RUN chmod +x /usr/local/bin/zynd-entrypoint

ENTRYPOINT ["/usr/local/bin/zynd-entrypoint"]
CMD ["python", "/app/agent.py"]
