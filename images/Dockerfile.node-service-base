# Base image for Zynd JS/TS services deployed via zynd-deployer.
#
# Slice 1: identical to node-agent-base (zyndai, dotenv, zod, tsx only).
# Services rarely need LangChain/Mastra, so the agent-base and service-base
# intentionally start identical. They will diverge in Slice 2 when the
# agent-base gains the full framework matrix.
#
#   docker build -f images/Dockerfile.node-service-base -t zynd-deployer/node-service-base:latest .

FROM node:22-slim

ENV NODE_ENV=production

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/zynd-base \
 && cd /opt/zynd-base \
 && npm init -y >/dev/null \
 && npm install --omit=dev --no-audit --no-fund \
      zyndai \
      dotenv \
      zod \
      tsx

ENV NODE_PATH=/opt/zynd-base/node_modules

WORKDIR /app

EXPOSE 5000

COPY images/entrypoint-node.sh /usr/local/bin/zynd-entrypoint
RUN chmod +x /usr/local/bin/zynd-entrypoint

ENTRYPOINT ["/usr/local/bin/zynd-entrypoint"]
CMD ["node", "/opt/zynd-base/node_modules/.bin/tsx", "/app/service.ts"]
