# Base image for Zynd services deployed via zynd-deployer.
#
# Slim: just zyndai-agent + fastapi + python-dotenv. Services rarely
# need the full LangChain/CrewAI stack.
#   docker build -f images/Dockerfile.service-base -t zynd-deployer/service-base:latest .

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
      zyndai-agent \
      python-dotenv \
      requests \
      httpx \
      fastapi \
      uvicorn

WORKDIR /app

EXPOSE 5000

COPY images/entrypoint.sh /usr/local/bin/zynd-entrypoint
RUN chmod +x /usr/local/bin/zynd-entrypoint

ENTRYPOINT ["/usr/local/bin/zynd-entrypoint"]
CMD ["python", "/app/service.py"]
