// zynd-deployer — Prisma schema
//
// See PLAN.md §8 for field rationale.
// There is no User model. Developer attribution is whatever the uploaded
// keypair resolves to on the zynd-dns registry.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Deployment ----------------------------------------------------

model Deployment {
  id            String   @id @default(cuid())

  // --- user-facing identifiers ---
  name          String                          // from config.name
  slug          String   @unique                // slugify(name) + short suffix
  entityType    String                          // "agent" | "service"
  entityId      String?                         // filled in after first successful start
  registryUrl   String                          // snapshot at upload time

  // --- lifecycle ---
  status        String                          // queued | unpacking | writing_config |
                                                // allocating_port | building | starting |
                                                // health_checking | registering_route |
                                                // running | unhealthy | failed | stopped | crashed
  errorMessage  String?

  // --- on-disk storage ---
  blobPath      String                          // .../blobs/<id>.zip.age
  keyPath       String                          // .../keys/<id>/keypair.json.age

  // --- language runtime ---
  runtime       String   @default("python")      // "python" | "node"

  // --- container image ---
  // Operator-built flavor image the user picked at deploy time
  // (e.g. "zynd-deployer/agent-playwright:latest"). Null = fall back
  // to the per-runtime base image resolved by the worker. Image must
  // carry zynd.runtime / zynd.kind / zynd.flavor labels — see
  // images/Dockerfile.*-base for the schema.
  image         String?

  // --- runtime ---
  port          Int?                             // host-side port bound to 127.0.0.1 (non-unique; PortAllocation is source of truth)
  containerId   String?
  hostUrl       String?                         // https://<slug>.deployer.zynd.ai
  publicKeyB64  String?                         // shown in UI, derived from keypair

  // --- crash state ---
  lastExitCode  Int?
  lastCrashAt   DateTime?

  // --- timestamps ---
  createdAt     DateTime @default(now())
  startedAt     DateTime?
  stoppedAt     DateTime?

  logs          DeploymentLog[]

  @@index([status])
  @@index([createdAt])
}

// ---------- DeploymentLog -------------------------------------------------

model DeploymentLog {
  id           BigInt    @id @default(autoincrement())
  deploymentId String
  lineNo       Int                              // monotonic per-deployment
  text         String    @db.Text
  stream       String                           // "stdout" | "stderr" | "system"
  ts           DateTime  @default(now())

  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId, lineNo])
  @@index([deploymentId, ts])
}

// ---------- DeploymentMetric ----------------------------------------------
//
// Per-container CPU and memory samples captured by worker/metrics.ts on
// a fixed interval. Retention is enforced by worker/retention.ts using
// DEPLOYER_METRIC_RETENTION_DAYS (default 3) — metrics accumulate fast
// (one row per deployment per sample) and are only useful recent.

model DeploymentMetric {
  id           BigInt    @id @default(autoincrement())
  deploymentId String
  sampledAt    DateTime  @default(now())
  memUsedMb    Int                               // cgroup memory.usage_in_bytes / 1MB
  memLimitMb   Int                               // cgroup memory.limit_in_bytes / 1MB
  cpuPct       Float                             // 0..1 (fraction of one logical CPU)

  @@index([deploymentId, sampledAt])
  @@index([sampledAt])
}

// ---------- PortAllocation ------------------------------------------------
//
// Source of truth for port uniqueness. A row here means the port is
// reserved; Deployment.port is a non-unique display mirror that can lag
// behind (e.g. stays set on a crashed deployment for debugging).

model PortAllocation {
  port         Int      @id
  deploymentId String   @unique
  takenAt      DateTime @default(now())
}
